# Copy this file to .env (local_test) or .env.staging / .env.production and fill in.
# .env* files are gitignored — never commit real values.

# local_test | staging | production
# See src/config/env.ts for what each mode changes.
VITE_APP_ENV=local_test

# Marks this build/user as internal test traffic. Internal test users must
# NEVER count toward revenue-eligible engagement — see
# src/services/qualification/qualificationEngine.ts and the
# `internal_test_user` event. Leave "true" for your own dev/QA devices.
VITE_INTERNAL_TEST_USER=true

# --- Firebase (only read in staging/production, see src/config/firebaseConfig.ts) ---
# These values are the public Firebase *client* config (not secrets — access
# is enforced by Firestore/Storage security rules and App Check, not by
# hiding this object). Paste them from Firebase Console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
